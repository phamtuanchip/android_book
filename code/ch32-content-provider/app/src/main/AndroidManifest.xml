<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.HelloAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- android:exported="true" BẮT BUỘC để app KHÁC (module :client) truy cập
             được — khác mặc định "false" nên dùng cho hầu hết Activity/Service chỉ
             dùng nội bộ (Chương 8, 16). Một Provider thật cần cân nhắc thêm
             android:readPermission/writePermission nếu không muốn MỌI app khác
             trên máy đều đọc/ghi được (xem thảo luận trong Chương 32). -->
        <provider
            android:name=".NoteProvider"
            android:authorities="vn.example.ch32provider.provider"
            android:exported="true" />
    </application>

</manifest>
