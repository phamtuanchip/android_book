# Sao chép file này thành "keystore.properties" (bỏ ".example") ở CÙNG THƯ MỤC,
# rồi điền đúng thông tin keystore thật của bạn — xem README.md. File
# "keystore.properties" thật KHÔNG được commit (đã có trong .gitignore).

storeFile=release-key.jks
storePassword=CHANGE_ME
keyAlias=my-app-key
keyPassword=CHANGE_ME
