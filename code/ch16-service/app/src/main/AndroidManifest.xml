<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.HelloAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType="dataSync" chỉ mang tính minh hoạ cho ví dụ đếm số
             đơn giản này — trong app thật, chọn type khớp đúng bản chất công việc
             (mediaPlayback, location...), bắt buộc từ Android 14 (API 34). -->
        <service
            android:name=".CounterService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
